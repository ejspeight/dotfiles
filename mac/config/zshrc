export ZSH="$HOME/.oh-my-zsh"

# Starship owns the prompt; Oh My Zsh provides plugins and completions.
ZSH_THEME=""
SPROMPT='Correct %F{yellow}%R%f to %F{green}%r%f? [nyae] '

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source "$ZSH/oh-my-zsh.sh"

# Correct mistyped command names without changing arguments or paths.
setopt CORRECT
unsetopt CORRECT_ALL

# ── Homebrew ──────────────────────────────────────────────────────────────────
export PATH="/opt/homebrew/bin:$PATH"

# ── NVM ───────────────────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && source "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && source "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# ── Python ────────────────────────────────────────────────────────────────────
alias python="python3"
alias pip="pip3"

# ── Better shell tools ────────────────────────────────────────────────────────
# Guarded, so a machine set up without these still has a working ls and cat.
if command -v eza >/dev/null 2>&1; then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -la --icons --group-directories-first"
fi

if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
fi

# fzf shell integration
[ -f "/opt/homebrew/opt/fzf/shell/completion.zsh" ] && source "/opt/homebrew/opt/fzf/shell/completion.zsh"
[ -f "/opt/homebrew/opt/fzf/shell/key-bindings.zsh" ] && source "/opt/homebrew/opt/fzf/shell/key-bindings.zsh"

# zoxide (smarter cd — use 'z' instead of 'cd')
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# ── 1Password SSH Agent ───────────────────────────────────────────────────────
# Only when the agent is actually running: exporting this unconditionally
# points ssh at a socket that may not exist and breaks all key auth.
_op_agent_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/agent.sock"
if [ -S "$_op_agent_sock" ]; then
  export SSH_AUTH_SOCK="$_op_agent_sock"
fi
unset _op_agent_sock

# ── Local LLM (Ollama + llm) ──────────────────────────────────────────────────
# Commands starting with a space are not saved to history (for private prompts).
setopt HIST_IGNORE_SPACE

# wtf: rerun the last command and ask the local model why it failed.
# Reruns the command, so avoid after anything destructive.
wtf() {
  local cmd=$(fc -ln -1)
  eval "$cmd" 2>&1 | tail -100 | llm "I ran: $cmd
Explain what went wrong and how to fix it."
}

# Searchable shell history (Ctrl-R and Up Arrow).
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# Minimal Catppuccin prompt with Git and project runtime indicators.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
